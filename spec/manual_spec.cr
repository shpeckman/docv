# spec/manual_spec.cr
require "./spec_helper"

# The shard's own manual pages, in man/: written by hand, and generated by
# `docv gen-cr` from the doc comments.
MANUAL    = {"man1", "man5"}.flat_map { |dir| Dir.glob(File.join(__DIR__, "..", "man", dir, "*")) }.sort
GENERATED = {"man3", "man7"}.flat_map { |dir| Dir.glob(File.join(__DIR__, "..", "man", dir, "*")) }.sort

describe "docv's manual" do
  it "has its pages" do
    MANUAL.map { |path| File.basename(path) }.should eq ["docv.1", "docv-config.5"]
    GENERATED.map { |path| File.basename(path) }.should eq ["docv.3cr.gz", "docv.7cr.gz"]
  end

  it "parses the generated API pages without unknown requests or macros" do
    GENERATED.each { |path| Docv.load(path).messages.should be_empty }
  end

  MANUAL.each do |path|
    it "parses #{File.basename(path)} without unknown requests or macros" do
      doc = Docv.load(path)
      doc.messages.should be_empty
      name, section = Docv::Manpath.split(File.basename(path)).not_nil!
      doc.reference.should eq "#{name.upcase}(#{section})"
      Docv::Layout.new(doc).lines(80).none? { |line| line.width > 80 }.should be_true
    end
  end

  it "is found as a project tree" do
    root = File.expand_path(File.join(__DIR__, ".."))
    Docv::Manpath.discover(root).should contain(File.join(root, "man"))
  end
end
