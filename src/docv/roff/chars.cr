    # Combining marks of the two-character accent names (`'e` is é).
    ACCENTS = {
      '\'' => '́', '`' => '̀', '^' => '̂', ':' => '̈', '~' => '̃',
      ',' => '̧', 'o' => '̊', 'v' => '̌', '"' => '̋', '-' => '̄',
      'u' => '̆', '.' => '̇', 'h' => '̨',
    }

    # Also handles `uXXXX` (`_` joins composites), `charNNN` and accents (`'e`); `nil` if unknown.
    def self.[]?(name : String) : String?
      if found = TABLE[name]?
        return found
      end
      if name.size >= 5 && name[0] == 'u' && name[1..].each_char.all? { |char| char.hex? || char == '_' }
        return String.build do |io|
          name[1..].split('_').each { |hex| hex.to_i?(16).try { |code| io << code.chr if code <= 0x10FFFF } }
        end.unicode_normalize(:nfc)
      end
      if name.starts_with?("char") && (code = name[4..].to_i?)
        return code.chr.to_s if 0 <= code <= 255
      end
      if name.size == 2 && (mark = ACCENTS[name[0]]?) && name[1].ascii_letter?
        return "#{name[1]}#{mark}".unicode_normalize(:nfc)
      end
      nil
    end
  end
