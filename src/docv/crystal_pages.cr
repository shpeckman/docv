# src/docv/crystal_pages.cr
require "html"
require "json"
require "../docv"
require "./crystal_pages/model"
require "./crystal_pages/roff"
require "./crystal_pages/pages"

module Docv
  # Man pages for a Crystal shard (`docv gen-cr`): `README.md` and the API
  # doc comments, read through `crystal docs --format json`, rendered as
  # man(7) roff. One section 3 page per type (`Foo::Bar.3cr`), a page for
  # the top level when it declares anything, and a section 7 overview named
  # after the shard. Markdown goes through markd (`Markdown.tree`).
  #
  # ```
  # root = Docv::CrystalPages::Shard.root(Dir.current) || abort "not in a shard"
  # puts Docv::CrystalPages.generate(root, File.join(root, "man"))
  # ```
  module CrystalPages
    # Name of this generator, written into every page it generates.
    GENERATOR = "docv gen-cr"

    # Comment text that marks a generated page. Only pages carrying it are
    # replaced or removed; pages of other generators that say the same
    # count too.
    MARKER    = "Generated by #{GENERATOR}"
    GENERATED = "from README.md and the doc comments; regenerate instead of editing."

    # Page name suffix after the section number (`Foo.3cr`), so the pages
    # never shadow C library pages.
    SUFFIX = "cr"

    # Manual section of the type pages and of the overview page.
    TYPE_SECTION     = "3"
    OVERVIEW_SECTION = "7"

    # The default output directory, relative to the shard root.
    OUTPUT = "man"

    # Raised for every failure reported to the user.
    class Error < Exception
    end

    # Type path without generic arguments: `Foo(K, V)::Bar(T)` becomes
    # `Foo::Bar`.
    def self.base_name(full_name : String) : String
      name = full_name
      while (stripped = name.gsub(/\([^()]*\)/, "")) != name
        name = stripped
      end
      name
    end

    # Type names without the global `::` prefix the doc generator adds to
    # some return types.
    def self.clean_type(text : String) : String
      text.gsub(/(\A|[\s(|,])::(?=[A-Z])/) { |_, md| md[1] }
    end

    # First sentence of the first paragraph of *markdown*, by the rule of the
    # HTML doc generator.
    def self.summary(markdown : String?) : String
      paragraph = markdown.to_s.strip.split(/\n[ \t]*\n/, 2).first? || ""
      line = paragraph.gsub(/(?:\\|[ \t]*)\n[ \t]*/, " ")
      (dot = line =~ /\.(\s|\z)/) ? line[0..dot] : line
    end

    # The markd blocks of a doc comment or README: `:showdoc:`, surrounding
    # whitespace and HTML without text (comments) dropped, adjacent text
    # nodes merged (markd splits text at `:` and other characters).
    def self.blocks(text : String?) : Array(Markd::Node)
      root = Markdown.tree(text.to_s.strip.lchop(":showdoc:").strip)
      merge_text(root)
      children(root).reject do |block|
        block.type.html_block? && block.text.gsub(Markdown::HTML_MARKUP, "").blank?
      end
    end

    private def self.merge_text(node : Markd::Node) : Nil
      child = node.first_child?
      while child
        while child.type.text? && (following = child.next?) && following.type.text?
          child.text += following.text
          following.unlink
        end
        merge_text(child)
        child = child.next?
      end
    end

    # The child nodes of *node*.
    def self.children(node : Markd::Node) : Array(Markd::Node)
      list = [] of Markd::Node
      child = node.first_child?
      while child
        list << child
        child = child.next?
      end
      list
    end

    # The text of *node* without markup, line breaks as spaces.
    def self.plain(node : Markd::Node) : String
      String.build { |io| plain(node, io) }
    end

    private def self.plain(node : Markd::Node, io : IO) : Nil
      children(node).each do |child|
        case child.type
        when .text?, .code?             then io << child.text
        when .soft_break?, .line_break? then io << ' '
        else                                 plain(child, io)
        end
      end
    end

    # A code block node holding *text*.
    def self.code_block(text : String) : Markd::Node
      node = Markd::Node.new(Markd::Node::Type::CodeBlock)
      node.text = text
      node
    end

    # Renders the pages of the shard in *root* into *output*; returns a
    # report line.
    def self.generate(root : String, output : String) : String
      project = DocTool.load(root)
      shard = Shard.new(root, project.repository_name)
      shown = Path[output].relative_to?(root).try(&.to_s).try { |path| path.starts_with?("..") ? nil : path } || output
      pages = Pages.new(shard, Types.new(project), shown).all
      written, unchanged, removed = Generator.new(output, Generator.today).run(pages)
      "#{shown}: #{written} written, #{unchanged} unchanged, #{removed} removed"
    end
  end
end
