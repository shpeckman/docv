# src/docv/crystal_pages.cr

require "compress/gzip"
require "html"
require "json"
require "../docv"
require "./crystal_pages/model"
require "./crystal_pages/roff"
require "./crystal_pages/pages"
require "./crystal_pages/session"

module Docv
  # Generates two gzipped man pages for a Crystal shard (`docv gen-cr`): a
  # section 7 overview from its `README.md` (`name.7cr.gz`) and a section 3
  # API page with a section per type from its doc comments (`name.3cr.gz`).
  #
  # ```
  # root = Docv::CrystalPages::Shard.root(Dir.current) || abort "not in a shard"
  # puts Docv::CrystalPages.generate(root, File.join(root, "man"))
  # ```
  module CrystalPages
    # :nodoc:
    GENERATOR = "docv gen-cr"

    # :nodoc:
    MARKER = "Generated by #{GENERATOR}"
    # :nodoc:
    # Only files containing this are replaced or removed, whichever generator wrote them.
    GENERATED = "from README.md and the doc comments; regenerate instead of editing."

    # Page name suffix after the section number (`name.3cr`), so the pages
    # never shadow C library pages.
    SUFFIX = "cr"

    # Extension of the gzipped page files.
    COMPRESSION = ".gz"

    # Manual section of the API page.
    TYPE_SECTION = "3"
    # Manual section of the overview page.
    OVERVIEW_SECTION = "7"

    # The default output directory, relative to the shard root.
    OUTPUT = "man"

    # Raised when generating pages fails.
    class Error < Exception
    end

    # :nodoc:
    # `Foo(K, V)::Bar(T)` → `Foo::Bar`.
    def self.base_name(full_name : String) : String
      name = full_name
      while (stripped = name.gsub(/\([^()]*\)/, "")) != name
        name = stripped
      end
      name
    end

    # :nodoc:
    # Drops the global `::` prefix `crystal docs` adds to some types.
    def self.clean_type(text : String) : String
      text.gsub(/(\A|[\s(|,])::(?=[A-Z])/) { |_, md| md[1] }
    end

    # :nodoc:
    # First sentence of the first paragraph, as the HTML doc generator picks it.
    def self.summary(markdown : String?) : String
      paragraph = markdown.to_s.strip.split(/\n[ \t]*\n/, 2).first? || ""
      line = paragraph.gsub(/(?:\\|[ \t]*)\n[ \t]*/, " ")
      (dot = line =~ /\.(\s|\z)/) ? line[0..dot] : line
    end

    # :nodoc:
    # Drops `:showdoc:` and text-less HTML; merges the text nodes markd splits at `:`.
    def self.blocks(text : String?) : Array(Markd::Node)
      root = Markdown.tree(text.to_s.strip.lchop(":showdoc:").strip)
      merge_text(root)
      children(root).reject do |block|
        block.type.html_block? && block.text.gsub(Markdown::HTML_MARKUP, "").blank?
      end
    end

    private def self.merge_text(node : Markd::Node) : Nil
      child = node.first_child?
      while child
        while child.type.text? && (following = child.next?) && following.type.text?
          child.text += following.text
          following.unlink
        end
        merge_text(child)
        child = child.next?
      end
    end

    # :nodoc:
    def self.children(node : Markd::Node) : Array(Markd::Node)
      list = [] of Markd::Node
      child = node.first_child?
      while child
        list << child
        child = child.next?
      end
      list
    end

    # :nodoc:
    # Text without markup, line breaks as spaces.
    def self.plain(node : Markd::Node) : String
      String.build { |io| plain(node, io) }
    end

    private def self.plain(node : Markd::Node, io : IO) : Nil
      children(node).each do |child|
        case child.type
        when .text?, .code?             then io << child.text
        when .soft_break?, .line_break? then io << ' '
        else                                 plain(child, io)
        end
      end
    end

    # :nodoc:
    def self.code_block(text : String) : Markd::Node
      node = Markd::Node.new(Markd::Node::Type::CodeBlock)
      node.text = text
      node
    end

    # Generates the pages of the shard in *root* into the directory *output*;
    # returns a one-line report. Raises `Error` when `crystal docs` fails or
    # *output* holds a file of the same name that was not generated.
    def self.generate(root : String, output : String) : String
      shown = Path[output].relative_to?(root).try(&.to_s).try { |path| path.starts_with?("..") ? nil : path } || output
      "#{shown}: #{write(pages(root, shown), output)}"
    end

    # :nodoc:
    # The pages of the shard in *root*, their path comments under *shown*.
    def self.pages(root : String, shown : String, quiet : Bool = false) : Array(Page)
      project = DocTool.load(root, quiet)
      Pages.new(Shard.new(root, project.repository_name), Types.new(project), shown).all
    end

    # :nodoc:
    # Writes *pages* into *output*; reports the counts.
    def self.write(pages : Array(Page), output : String) : String
      written, unchanged, removed = Generator.new(output, Generator.today).run(pages)
      "#{written} written, #{unchanged} unchanged, #{removed} removed"
    end
  end
end
