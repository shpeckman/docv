T}	T{
highlight it
T}
T{
click a page in the tree
T}	T{
open it
T}
T{
click a group in the tree
T}	T{
fold or unfold it
T}
T{
wheel / \fB\%Shift\fR\-wheel over the dock
T}	T{
scroll the tree / scroll it sideways
T}
T{
drag the dock\(aqs right edge
T}	T{
resize the dock
T}
T{
back button (Aux8)
T}	T{
back to the previous page
T}
T{
click \fB\%\[uFF24]\[uFF2F]\[uFF23]\[uFF36] \%v0.1.0\fR (start of the title row)
T}	T{
open the help
T}
T{
point at the page\(aqs heading
T}	T{
show the page\(aqs source and date beside it
T}
