T}	T{
select the paragraph (the lines with text around it in blocks of the same kind; a heading alone) and copy it
T}
T{
drag a scrollbar thumb (right and bottom border)
T}	T{
scroll
T}
T{
click a scrollbar track
T}	T{
page in that direction
T}
T{
