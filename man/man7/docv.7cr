.PP
.TS
tab(	);
l lx.
T{
\fBTree keys\fR
T}	T{
\fBAction\fR
T}
_
T{
\fB\%j\fR \fB\%\[u2193]\fR \fB\%Ctrl\-n\fR / \fB\%k\fR \fB\%\[u2191]\fR \fB\%Ctrl\-p\fR
T}	T{
next / previous page or group
T}
T{
\fB\%PgDn\fR / \fB\%PgUp\fR
T}	T{
a screenful down / up
T}
T{
\fB\%g\fR \fB\%Home\fR / \fB\%G\fR \fB\%End\fR
